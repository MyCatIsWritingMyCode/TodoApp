{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "TodoApp.Api",
    "Audience": "TodoApp.Client",
    "SecretKey": "YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS_LONG!",
    "ExpiryMinutes": 1440
  },
  "Encryption": {
    "Key": "YOUR_ENCRYPTION_KEY_32_CHARS_EXACTLY!"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;"
  }
}
